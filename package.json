{
  "name": "localtube",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only YouTube player backed by a project-local yt-dlp",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "lan": "set LAN=1&& node server.js",
    "update-ytdlp": "bin\\yt-dlp.exe -U",
    "lan:unix": "LAN=1 node server.js",
    "update-ytdlp:unix": "yt-dlp -U",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File build-release.ps1",
    "release:debugkey": "powershell -NoProfile -ExecutionPolicy Bypass -File build-release.ps1 -DebugKey"
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}
